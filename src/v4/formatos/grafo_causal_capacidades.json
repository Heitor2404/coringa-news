        "asset_family": "optics"
      },
      {
        "id": "projection_optics",
        "tipo": "sistema_espelhos",
        "asset_family": "optics"
      },
      {
        "id": "wafer",
        "tipo": "substrato",
        "asset_family": "semiconductor"
      },
      {
        "id": "resist",
        "tipo": "camada_fotossensivel",
        "asset_family": "semiconductor"
      }
    ],
    "relacoes": [
      {
        "from": "light_source",
        "type": "illuminates",
        "to": "reticle"
      },
      {
        "from": "reticle",
        "type": "reflects_to",
        "to": "projection_optics"
      },
      {
        "from": "projection_optics",
        "type": "projects_to",
        "to": "resist"
      },
      {
        "from": "resist",
        "type": "rests_on",
        "to": "wafer"
      }
    ],
    "estado_inicial": {
      "light_source.emitting": "off",
      "reticle.illuminated": "no",
      "projection_optics.pattern": "inactive",
      "resist.exposure": "unexposed"
    },
    "eventos": [
      {
        "acao": "source",
        "operador": "emit",
        "atores": [
          "light_source"
        ],
        "foco": [
          "light_source",
          "reticle"
        ],
        "camera": "show_connection",
        "requer": {
          "light_source.emitting": "off"
        },
        "altera": {
          "light_source.emitting": "on"
        }
      },
      {
        "acao": "reticle",
        "operador": "reflect",
        "atores": [
          "reticle"
        ],
        "foco": [
          "light_source",
          "reticle",
          "projection_optics"
        ],
        "camera": "show_connection",
        "requer": {
          "light_source.emitting": "on",
          "reticle.illuminated": "no"
        },
        "altera": {
          "reticle.illuminated": "yes"
        }
      },
      {
        "acao": "projection",
        "operador": "project",
        "atores": [
          "projection_optics"
        ],
        "foco": [
          "reticle",
          "projection_optics",
          "resist"
        ],
        "camera": "show_connection",
        "requer": {
          "reticle.illuminated": "yes",
          "projection_optics.pattern": "inactive"
        },
        "altera": {
          "projection_optics.pattern": "active"
        }
      },
      {
        "acao": "wafer",
        "operador": "expose",
        "atores": [
          "resist",
          "wafer"
        ],
        "foco": [
          "projection_optics",
          "resist",
          "wafer"
        ],
        "camera": "show_consequence",
        "requer": {
          "projection_optics.pattern": "active",
          "resist.exposure": "unexposed"
        },
        "altera": {
          "resist.exposure": "exposed"
        }
      }
    ],
    "fontes_visuais": "componentes_cadastrados_sem_inspecao_por_pixels",
    "renderer": "OpticalProjection.tsx"
  },
